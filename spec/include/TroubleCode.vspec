TroubleCode:
  type: struct
  description: Protocol-neutral diagnostic trouble-code record.

TroubleCode.ID:
  datatype: string
  type: property
  description: Identifier unique within one ECU and CodeSystem; the same ID may occur for another ECU or code system.

TroubleCode.ECU:
  datatype: string
  type: property
  description: Stable identifier of the reporting ECU or diagnostic source, unique within the vehicle.
              When CodeSystem is SAE-J1939, use the decimal source address (e.g. "0").
              When Details include sourceAddress, ECU MUST equal that value.

TroubleCode.CodeSystem:
  datatype: string
  type: property
  description: Code-system identifier, such as SAE-J2012, SAE-J1939, or a globally unique vendor namespace.

TroubleCode.HasCode:
  datatype: boolean
  type: property
  description: True when Code contains a source-provided identifier in the representation defined by CodeSystem.

TroubleCode.Code:
  datatype: string
  type: property
  description: Source-provided trouble-code identifier; empty when HasCode is false.
              SAE-J1939 - "<SPN>:<FMI>" decimal (e.g. "1569:31").
              SAE-J2012 - base short form letter + 4 hex digits (e.g. "P2380").
              Failure Type Byte MUST NOT be encoded in Code; use Details.failureTypeByte.

TroubleCode.HasDetails:
  datatype: boolean
  type: property
  description: True when Details contains a schema-defined JSON object.

TroubleCode.DetailsSchema:
  datatype: string
  type: property
  description: Versioned URI identifying the Details schema, or empty when HasDetails is false.
              Recognized COVESA URIs -
                urn:covesa:vss:diagnostics:sae-j1939:v1
                urn:covesa:vss:diagnostics:sae-j2012:v1
                urn:covesa:vss:diagnostics:wwh-obd:v1
              See docs/diagnostics/ for normative JSON Schemas.

TroubleCode.HasDetailsSchemaDigest:
  datatype: boolean
  type: property
  description: True when DetailsSchemaDigest is populated.

TroubleCode.DetailsSchemaDigest:
  datatype: string
  type: property
  description: Content digest of the Details schema document identified by DetailsSchema
              (e.g. "sha256:<hex>"). Empty when HasDetailsSchemaDigest is false.
              Enables local cache or catalog lookup without repeated network fetches.

TroubleCode.Details:
  datatype: string
  type: property
  description: JSON object encoded as a string and defined by DetailsSchema; empty when HasDetails is false.

TroubleCode.HasStatus:
  datatype: boolean
  type: property
  description: True when Status is available and can be mapped to the normalized values below.

TroubleCode.Status:
  datatype: uint8
  type: property
  enum:
    'UNKNOWN': 0
    'ACTIVE': 1
    'PENDING': 2
    'INACTIVE': 3
  description: Normalized state ACTIVE, PENDING, INACTIVE, or UNKNOWN; empty when HasStatus is false.
              UNKNOWN means a status was supplied but could not be mapped.
              Do not map permanent DTCs to INACTIVE; omit permanent from ActiveTroubleCodes.

TroubleCode.HasOccurrenceCount:
  datatype: boolean
  type: property
  description: True when OccurrenceCount is available.

TroubleCode.OccurrenceCount:
  datatype: uint32
  type: property
  description: Occurrence count as reported or mapped; use zero when HasOccurrenceCount is false.

TroubleCode.HasLastObserved:
  datatype: boolean
  type: property
  description: True when LastObserved is available.

TroubleCode.LastObserved:
  datatype: string
  type: property
  description: ISO 8601 timestamp of the last observation; empty when HasLastObserved is false.
