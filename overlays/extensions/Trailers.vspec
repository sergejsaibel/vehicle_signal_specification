#
# PROPOSAL: Dynamic trailer branches
#
# Overlay adding support for up to 5 trailers that can be coupled and decoupled
# at any time (e.g. truck with full trailer, road trains, B-doubles, dollies).
#
# The proposal introduces dynamic branches, see docs-gen/content/extensions/dynamic_branches.md
# for the complete definition. In short:
#
#   - A dynamic branch is a normal branch that declares "events" and "actions".
#   - Its static signals (not marked dynamic) always exist.
#   - Its dynamic signals (marked "dynamic: true") are created and removed by the broker.
#   - An event has a trigger signal. When the trigger fires, the broker executes the
#     actions listed in the event.
#
# Tooling must whitelist the extended attributes dynamic, events and actions:
#
#   vspec export json -u spec/units.yaml --strict -e dynamic -e events -e actions \
#     -l overlays/extensions/Trailers.vspec \
#     -s spec/VehicleSignalSpecification.vspec -o vss_trailers.json
#
# Overview of the five trailer branches:
#
#   Branch    Resolve action               Input of the resolve action
#   -------   --------------------------   ------------------------------------------
#   Trailer1  ResolveBranchByUri           Vehicle.Trailers.ConfigurationUri (+ Id)
#   Trailer2  ResolveBranchBySignalData    Vehicle.Trailers.Trailer2.Vss
#   Trailer3  ResolveBranchByUri           Vehicle.Trailers.ConfigurationUri (+ Id)
#   Trailer4  ResolveBranchByUri           Vehicle.Trailers.ConfigurationUri (+ Id)
#   Trailer5  ResolveBranchByUri           Vehicle.Trailers.ConfigurationUri (+ Id)
#
# All trailer branches have the event Connected (resolve, trigger condition OnFalseToTrue) and the event
# Disconnected (action RemoveDynamicSignals, trigger condition OnTrueToFalse), both on the signal IsConnected
# of the branch.
#
# The dynamic signals (Trailers/TrailerDynamic.vspec, the gross list) are NOT included here, to keep the tree
# small. They are brought in by a resolved trailer configuration, see Trailers/examples/ExampleSemiTrailer.vspec.
#

Vehicle:
  type: branch

Vehicle.Trailers:
  type: branch
  description: Trailers that can be coupled to and decoupled from the vehicle during operation.
  comment: Contains the dynamic branches Trailer1 to Trailer5. Trailers are numbered in coupling order,
           Trailer1 is the trailer coupled directly to the towing vehicle, Trailer2 is coupled to Trailer1, and so on.
           A converter dolly counts as a trailer. The number reflects the position in the combination,
           not the identity of the trailer. The identity is given by the signal Id of the trailer branch.

Vehicle.Trailers.MaxCount:
  datatype: uint8
  type: attribute
  max: 5
  default: 5
  description: Maximum number of trailers supported by the vehicle.

Vehicle.Trailers.ConnectedCount:
  datatype: uint8
  type: sensor
  max: 5
  description: Number of trailers currently coupled to the vehicle.
  comment: Equals the number of trailer branches where IsConnected is true.

Vehicle.Trailers.ConfigurationUri:
  datatype: string
  type: attribute
  description: URI template for retrieving the configuration of a trailer by its unique identifier.
  comment: Input of the action ResolveBranchByUri, used by all trailer branches that resolve by URI.
           One URI for all trailers, typically provided by the OEM of the towing vehicle.
           The URI is a URI template according to RFC 6570 with the variable {id}, which the broker replaces by
           the value of the signal Id in the trailer branch that triggered the action,
           e.g. https://vss.tractor-oem.example/v1/trailer-configurations/{id}.
           The service behind the URI maps the trailer identifier to the trailer OEM and returns
           the trailer configuration, either by redirecting (HTTP 3xx) to the trailer OEM or by forwarding its response.

#
# Trailer1 - resolved by URI
#
Vehicle.Trailers.Trailer1:
  type: branch
  description: Dynamic branch of the trailer coupled at position 1, directly to the towing vehicle.
  comment: The static signals always exist. All dynamic signals are created when IsConnected changes to true,
           and removed when it changes to false.
  actions:
    ResolveBranchByUri:
      description: Retrieves the trailer configuration from the URI and creates the dynamic signals of this branch from it.
      uri: Vehicle.Trailers.ConfigurationUri
    RemoveDynamicSignals:
      description: Removes all signals marked dynamic from this branch. Static signals are kept.
  events:
    Connected:
      description: The trigger signal changed from false to true, i.e. a trailer was coupled.
      trigger:
        OnFalseToTrue: Vehicle.Trailers.Trailer1.IsConnected
      actions: [ResolveBranchByUri]
    Disconnected:
      description: The trigger signal changed from true to false, i.e. the trailer was decoupled.
      trigger:
        OnTrueToFalse: Vehicle.Trailers.Trailer1.IsConnected
      actions: [RemoveDynamicSignals]

#include Trailers/TrailerStatic.vspec Vehicle.Trailers.Trailer1

#
# Trailer2 - resolved by signal data
#
Vehicle.Trailers.Trailer2:
  type: branch
  description: Dynamic branch of the trailer coupled at position 2.
  comment: The static signals always exist. All dynamic signals are created when IsConnected changes to true,
           and removed when it changes to false. This trailer provides its own branch definition in the signal Vss.
  actions:
    ResolveBranchBySignalData:
      description: Creates the dynamic signals of this branch from the branch definition contained in the data signal.
      data: Vehicle.Trailers.Trailer2.Vss
    RemoveDynamicSignals:
      description: Removes all signals marked dynamic from this branch. Static signals are kept.
  events:
    Connected:
      description: The trigger signal changed from false to true, i.e. a trailer was coupled.
      trigger:
        OnFalseToTrue: Vehicle.Trailers.Trailer2.IsConnected
      actions: [ResolveBranchBySignalData]
    Disconnected:
      description: The trigger signal changed from true to false, i.e. the trailer was decoupled.
      trigger:
        OnTrueToFalse: Vehicle.Trailers.Trailer2.IsConnected
      actions: [RemoveDynamicSignals]

Vehicle.Trailers.Trailer2.Vss:
  datatype: string
  type: sensor
  description: Branch definition of the trailer coupled at position 2, provided by the trailer.
  comment: Input data of the action ResolveBranchBySignalData. A static signal, so it exists before the dynamic signals are created.
           The value is a VSS overlay rooted at the trailer branch, in the YAML vspec syntax.
           It uses paths relative to Vehicle.Trailers.Trailer2 and narrows the dynamic signals to the ones the trailer has.
           Shall be set before or together with IsConnected changing to true.
           It is not removed when the trailer is decoupled.

#include Trailers/TrailerStatic.vspec Vehicle.Trailers.Trailer2

